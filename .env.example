# Copy to .env for local runs. On Railway, set these as project variables instead
# (railway.json/Dockerfile don't read .env directly - Railway injects env vars itself).

# --- OAuth client (create in Google Cloud Console > APIs & Services > Credentials) ---
# Application type: "Desktop app" for local/stdio use, "Web application" for the
# Railway deployment below (needs a Web client so the redirect URI can be registered).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Single-user mode: run this deployment as one Google account (you) ---
# Simplest setup for personal use - no per-request OAuth dance for other users.
MCP_SINGLE_USER_MODE=true
USER_GOOGLE_EMAIL=you@example.com

# --- Which services to expose (comma-separated). Sheets-only by default; see
# https://github.com/taylorwilsdon/google_workspace_mcp for the full service list
# (gmail, drive, calendar, docs, sheets, chat, forms, slides, tasks, contacts, search, appscript).
WORKSPACE_MCP_TOOLS=sheets

# --- Required only for remote/Railway deployment (streamable-http transport) ---
# Set to your Railway public URL, e.g. https://your-app.up.railway.app
# Then register "<that URL>/oauth2callback" as an Authorized redirect URI on the
# OAuth client above.
WORKSPACE_MCP_BASE_URI=

# Where OAuth tokens get cached on disk. On Railway this must point at a mounted
# volume, or you'll have to re-authenticate on every redeploy.
WORKSPACE_MCP_CREDENTIALS_DIR=/home/app/.google_workspace_mcp/credentials
